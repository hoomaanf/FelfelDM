{
  "manifest_version": 3,
  "name": "FelfelDM",
  "description": "Send downloads to FelfelDM",
  "version": "1.0.1",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "host_permissions": [
    "http://localhost:8765/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8766/*",
    "http://127.0.0.1:8766/*",
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png", "icons/icon128.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": [
    "contextMenus",
    "activeTab",
    "notifications",
    "downloads",
    "storage",
    "scripting",
    "alarms",
    "webRequest"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "FelfelDM",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "minimum_chrome_version": "109"
}
