{
  "manifest_version": 3,
  "name": "FelfelDM",
  "description": "FelfelDM Integration for Firefox",
  "version": "1.0.1",

  "permissions": [
    "contextMenus",
    "activeTab",
    "notifications",
    "downloads",
    "storage",
    "scripting",
    "alarms",
    "webRequest"
  ],

  "host_permissions": [
    "http://localhost:8765/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8766/*",
    "http://127.0.0.1:8766/*",
    "<all_urls>"
  ],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png", "icons/icon128.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "hoomaanfelfeli@gmail.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
